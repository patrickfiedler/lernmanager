# THIS REPO IS PUBLIC: github.com/patrickfiedler/lernmanager
#
# Whitelist, not blacklist. Everything is ignored unless named below.
#
# Why: real student data routinely sits in this working tree -- database copies,
# checkpoint exports, generated PDFs with names and plaintext passwords, uploaded
# artifacts, anonymization mappings. A blacklist has to anticipate every format
# those arrive in, and gets it wrong once. A whitelist only has to name what the
# application actually consists of, which changes slowly and visibly.
#
# Adding a new top-level file to the repo means adding a `!` line for it here.
# Files inside the whitelisted directories below need no new rule.
# `git status --ignored` shows what is being held back.

# Ignore every top-level entry ...
/*

# ... then re-include the project itself.

# Repo metadata
!/.gitignore
!/.env.example
!/LICENSE
!/README.md
!/requirements.txt
!/pytest.ini

# Application code
!/app.py
!/models.py
!/config.py
!/utils.py
!/run.py
!/llm_grading.py
!/quiz_grading.py
!/artifact_checker.py
!/artifact_processor.py
!/checkpoint_questions.py
!/analytics_queue.py
!/import_task.py
!/list_students.py
!/generate_weekly_reports.py

# Directories: re-including the directory un-ignores its contents, because the
# `/*` above only matches top-level entries.
!/deploy/
!/migrate/
!/static/
!/templates/
!/tests/

# --- exclusions inside the whitelisted directories ---

# Server-side only: crypto helper, the live nginx config (certbot rewrites it),
# and internal runbooks.
deploy/db_crypto.py
deploy/lernmanager.nginx.conf
deploy/*.md

# Teacher and student uploads: Lehrbuch PDFs, handed-in artifacts.
static/uploads/*
!static/uploads/.gitkeep

# Python bytecode, anywhere.
__pycache__/
*.py[cod]
